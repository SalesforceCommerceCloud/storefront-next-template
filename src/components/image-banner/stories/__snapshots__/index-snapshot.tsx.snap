exports[`Image Banner stories > Default renders campaign artwork 1`] = `
<div
  class="text-card-foreground flex flex-col rounded-ui border-ui border-border shadow-ui relative h-full overflow-hidden [--ui-border-width:0] ring-0 bg-transparent border-0 gap-0 py-0"
  data-slot="image-banner"
>
  <div
    class="p-0"
    data-slot="card-content"
  >
    <a
      aria-label="Discover the seasonal collection"
      class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset"
      data-discover="true"
      href="/global/en-GB/c/seasonal"
    >
      <div
        class="relative overflow-hidden bg-secondary/20 aspect-auto"
      >
        <div
          class="relative w-full"
        >
          <img
            alt="Discover the seasonal collection"
            class="object-cover h-auto w-full"
            fetchpriority="auto"
            height="240"
            loading="lazy"
            src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%221600%22%20height%3D%22240%22%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20fill%3D%22%23dde9df%22%2F%3E%3Ctext%20x%3D%225%25%22%20y%3D%2255%25%22%20font-size%3D%2232%22%20fill%3D%22%23173c2c%22%3EDiscover%20the%20seasonal%20collection%3C%2Ftext%3E%3C%2Fsvg%3E"
            style="object-position: 50% 50%;"
            width="1600"
          />
        </div>
      </div>
    </a>
  </div>
</div>
`;

