# ============================================================================
# Storefront Next - Required Configuration
# ============================================================================
# Only the variables below are REQUIRED to run the app or deploy it.
# All other settings have sensible defaults in config.server.ts.
#
# To enable optional features (hybrid proxy, Marketing Cloud, Turnstile,
# multi-site, commerce agent, etc.), see:
#   - Get started:           README.md
#   - Full reference:        docs/README-CONFIG.md
#   - All config options:    docs/README-CONFIG-OPTIONS.md
# ============================================================================

# ----------------------------------------------------------------------------
# Managed Runtime Deployment (used by `pnpm push`)
# These are read by the storefront-next-dev CLI; they are not runtime config.
# ----------------------------------------------------------------------------
MRT_PROJECT=DressUp
MRT_TARGET=Development

# ----------------------------------------------------------------------------
# B2C Commerce API credentials (REQUIRED for the storefront to call SCAPI)
# Pre-filled with the public demo backend (zzrf-041) so that
# `cp .env.default .env && pnpm dev` boots out-of-the-box. Replace these with
# your own credentials before deploying or pointing at a real storefront.
# ----------------------------------------------------------------------------
PUBLIC__app__commerce__api__clientId=ca539b55-23b0-49c9-b2d9-c01b1fc8411f
PUBLIC__app__commerce__api__organizationId=f_ecom_zyrz_001
PUBLIC__app__commerce__api__shortCode=0rcohlt0
PUBLIC__app__features__returnsCustomApi=true
PUBLIC__app__pages__search__enableSearchSuggestions=true

# ----------------------------------------------------------------------------
# Site context (overrides config.server.ts defaults for this storefront)
# MarketStreet is the site backing the Fashion (Retail) storefront.
# ----------------------------------------------------------------------------
PUBLIC__app__defaultSiteId=DressUp
#PUBLIC__app__commerce__sites=[{"cookies":{"domain":null},"id":"MarketStreet","alias":"Sites-MarketStreet-Site","name":"Sites-MarketStreet-Site","defaultLocale":"en-US","defaultCurrency":"USD","supportedLocales":[{"id":"en-US","preferredCurrency":"USD"},{"id":"en-GB","preferredCurrency":"USD"}],"supportedCurrencies":["USD","GBP"]}]
