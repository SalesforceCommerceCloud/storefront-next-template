{
    "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
    "root": true,
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx",
            "**/*.mts",
            "**/*.cts",
            "**/*.json",
            "!**/dist/**",
            "!**/build/**",
            "!**/output/**",
            "!**/node_modules/**",
            "!**/steps.d.ts",
            "!**/a11y-report/**",
            "!**/a11y-baseline.json",
            "!**/.claude/**"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "bracketSameLine": true,
        "bracketSpacing": true,
        "lineEnding": "lf",
        "useEditorconfig": false
    },
    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        },
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "quoteProperties": "asNeeded",
            "semicolons": "always",
            "trailingCommas": "es5",
            "arrowParentheses": "always",
            "bracketSameLine": true,
            "bracketSpacing": true
        }
    },
    "json": {
        "parser": {
            "allowComments": true,
            "allowTrailingCommas": true
        },
        "formatter": {
            "enabled": true,
            "indentWidth": 4,
            "trailingCommas": "none"
        }
    },
    "css": {
        "formatter": {
            "enabled": false
        }
    },
    "graphql": {
        "formatter": {
            "enabled": false
        }
    },
    "html": {
        "formatter": {
            "enabled": false
        }
    },
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    }
}
