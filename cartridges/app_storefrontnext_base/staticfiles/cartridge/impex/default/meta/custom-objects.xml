<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">

    <!--
        Storefront Next global (organization-level) preferences.
        Import via Business Manager: Administration > Site Development > Import & Export.
    -->
    <type-extension type-id="OrganizationPreferences">
        <custom-attribute-definitions>

            <!--
                Set to false to disable the cartridge's built-in notification feature.
                Use this if you have customized email delivery (e.g. Marketing Cloud, a
                third-party provider, or your own hook) and do not want the cartridge's
                default ISML-based emails to fire.

                When unset or set to true, all notification types are active (the default
                for new installs). Setting this to false causes the REST API to return 503
                and the sendOrderAccessCode hook to no-op — no emails are sent by the cartridge.
            -->
            <attribute-definition attribute-id="sfnextNotifyEnabled">
                <display-name xml:lang="x-default">Notifications Enabled</display-name>
                <description xml:lang="x-default">
                    Enable the built-in notification feature (email sending via ISML templates and dw/net/Mail).
                    Set to false if you have a custom email provider.
                    When unset, notifications are enabled by default.
                </description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="sfnextStorefrontHosts">
                <display-name xml:lang="x-default">Storefront Hosts</display-name>
                <description xml:lang="x-default">
                    Comma-separated list of allowed public-facing hostnames for the MRT/eCDN storefront,
                    without protocol or trailing slash.
                    Example: my-store.salesforcecommercecloudsites.com,staging.salesforcecommercecloudsites.com
                    Each entry is validated against the callerHost supplied by the BFF on notify requests.
                    A matching entry is returned as the trusted host for constructing magic-link URLs.
                    Required for magic-link and access-code emails in headless deployments.
                </description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>

        </custom-attribute-definitions>

        <group-definitions>
            <attribute-group group-id="sfnext">
                <display-name xml:lang="x-default">Storefront Next</display-name>
                <attribute attribute-id="sfnextNotifyEnabled"/>
                <attribute attribute-id="sfnextStorefrontHosts"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

</metadata>
