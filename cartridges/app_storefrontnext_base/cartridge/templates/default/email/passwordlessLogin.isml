<isinclude template="email/common/header"/>

  <!-- Heading -->
  <tr>
    <td style="padding-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;color:#17171B;line-height:1.3;">${Resource.msg('passwordlessLogin.heading', 'email', null)}</h1>
    </td>
  </tr>

  <!-- Instructions -->
  <tr>
    <td style="padding-bottom:32px;">
      <p style="margin:0;font-size:15px;color:#35353B;line-height:1.6;">${Resource.msg('passwordlessLogin.instructions', 'email', null)}</p>
    </td>
  </tr>

  <!-- Inline access code (conditionally rendered when token can be extracted from the magic link) -->
  <isif condition="${!empty(pdict.accessCode)}">
  <tr>
    <td style="padding-bottom:8px;">
      <p style="margin:0;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#646464;">${Resource.msg('passwordlessLogin.accessCodeLabel', 'email', null)}</p>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom:32px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="background-color:#F5F5F5;border:1px solid #E5E5E5;padding:20px;text-align:center;">
            <span style="font-size:32px;font-weight:700;letter-spacing:0.2em;color:#17171B;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;"><isprint value="${pdict.accessCode}" encoding="htmlcontent"/></span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  </isif>

  <isif condition="${!empty(pdict.magicLink)}">
  <!-- CTA button -->
  <tr>
    <td style="padding-bottom:32px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background-color:#131315;">
            <a href="${pdict.magicLink}" style="display:inline-block;padding:14px 32px;font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">${Resource.msg('passwordlessLogin.buttonText', 'email', null)}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  </isif>

  <!-- Disclaimer -->
  <tr>
    <td style="padding-bottom:16px;">
      <p style="margin:0;font-size:12px;color:#646464;line-height:1.5;">${Resource.msg('passwordlessLogin.disclaimer', 'email', null)}</p>
    </td>
  </tr>

  <isif condition="${!empty(pdict.magicLink)}">
  <!-- Copy URL fallback -->
  <tr>
    <td>
      <p style="margin:0;font-size:12px;color:#646464;line-height:1.5;">${Resource.msg('passwordlessLogin.copyUrl', 'email', null)}<br>
      <a href="${pdict.magicLink}" style="color:#131315;word-break:break-all;text-decoration:underline;"><span style="color:#131315;"><isprint value="${pdict.magicLink}" encoding="htmlcontent"/></span></a></p>
    </td>
  </tr>
  </isif>

<isinclude template="email/common/footer"/>
