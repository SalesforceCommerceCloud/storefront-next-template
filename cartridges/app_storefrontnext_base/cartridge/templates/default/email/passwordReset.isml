<isinclude template="email/common/header"/>

  <!-- Heading -->
  <tr>
    <td style="padding-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;color:#17171B;line-height:1.3;">${Resource.msg('passwordReset.heading', 'email', null)}</h1>
    </td>
  </tr>

  <!-- Instructions -->
  <tr>
    <td style="padding-bottom:32px;">
      <p style="margin:0;font-size:15px;color:#35353B;line-height:1.6;">${Resource.msg('passwordReset.instructions', 'email', null)}</p>
    </td>
  </tr>

  <isif condition="${!empty(pdict.magicLink)}">
  <!-- CTA button -->
  <tr>
    <td style="padding-bottom:32px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background-color:#131315;">
            <a href="${pdict.magicLink}" style="display:inline-block;padding:14px 32px;font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">${Resource.msg('passwordReset.buttonText', 'email', null)}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  </isif>

  <!-- Disclaimer -->
  <tr>
    <td style="padding-bottom:16px;">
      <p style="margin:0;font-size:12px;color:#646464;line-height:1.5;">${Resource.msg('passwordReset.disclaimer', 'email', null)}</p>
    </td>
  </tr>

  <isif condition="${!empty(pdict.magicLink)}">
  <!-- Copy URL fallback -->
  <tr>
    <td>
      <p style="margin:0;font-size:12px;color:#646464;line-height:1.5;">${Resource.msg('passwordReset.copyUrl', 'email', null)}<br>
      <a href="${pdict.magicLink}" style="color:#131315;word-break:break-all;">${pdict.magicLink}</a></p>
    </td>
  </tr>
  </isif>

<isinclude template="email/common/footer"/>
