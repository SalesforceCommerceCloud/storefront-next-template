<isinclude template="email/common/header"/>

  <!-- Heading -->
  <tr>
    <td align="center" style="padding-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;color:#17171B;line-height:1.3;">${Resource.msg('otpVerification.heading', 'email', null)}</h1>
    </td>
  </tr>

  <!-- Instructions -->
  <tr>
    <td align="center" style="padding-bottom:32px;">
      <p style="margin:0;font-size:15px;color:#35353B;line-height:1.6;">${Resource.msg('otpVerification.instructions', 'email', null)}</p>
    </td>
  </tr>

  <!-- OTP code -->
  <tr>
    <td align="center" style="padding-bottom:32px;">
      <div style="display:inline-block;background:#F5F5F5;padding:18px 40px;">
        <span style="font-size:34px;font-weight:700;letter-spacing:10px;color:#17171B;">${pdict.token}</span>
      </div>
    </td>
  </tr>

  <!-- Disclaimer -->
  <tr>
    <td align="center">
      <p style="margin:0;font-size:12px;color:#646464;line-height:1.5;">${Resource.msg('otpVerification.disclaimer', 'email', null)}</p>
    </td>
  </tr>

<isinclude template="email/common/footer"/>
